<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.yorkhuul.life.editor.ui.TemplatePanel">
  <grid id="27dc6" binding="panel1" default-binding="true" layout-manager="CardLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="b2503" binding="topContainer" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
        <constraints>
          <card name="topContainer"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="37859" class="javax.swing.JButton" binding="backButton">
            <constraints/>
            <properties>
              <text value="Back"/>
            </properties>
          </component>
          <component id="fe999" class="javax.swing.JLabel" binding="titleLabel">
            <constraints/>
            <properties>
              <text value=""/>
            </properties>
          </component>
          <component id="e140d" class="javax.swing.JButton" binding="nextButton">
            <constraints/>
            <properties>
              <text value="Next"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="5ac3d" binding="mapPanel" layout-manager="CardLayout" hgap="0" vgap="0">
        <constraints>
          <card name="Card3"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children/>
      </grid>
      <grid id="f5c22" binding="parametersPanel" layout-manager="CardLayout" hgap="0" vgap="0">
        <constraints>
          <card name="Card4"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children/>
      </grid>
    </children>
  </grid>
</form>
